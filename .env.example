# Beispiel für die lokale Datei .env (NICHT versionieren – .env steht in .gitignore)
# Kopieren: cp .env.example .env  und Platzhalter durch eigene, zufällige Werte ersetzen
# (z. B. python3 -c "import secrets; print(secrets.token_urlsafe(24))").

# Mosquitto-Konten (HA-App „Mosquitto broker“ → Konfiguration → logins)
MQTT_NODERED_PASSWORD=<zufaelliges-passwort-node-red>
MQTT_SENSOR_PASSWORD=<zufaelliges-passwort-sensorknoten>

# InfluxDB-Konten (werden von tools/setup_influx.py angelegt)
INFLUX_NODERED_PASSWORD=<zufaelliges-passwort-influx-schreiben>
INFLUX_GRAFANA_PASSWORD=<zufaelliges-passwort-influx-lesen>

# Passwort für verschlüsselte Home-Assistant-Backups – zusätzlich sicher aufbewahren!
HA_BACKUP_PASSWORD=<zufaelliges-backup-passwort>

# Zugang der Werkzeuge (tools/) und UI-Tests (dashboard/test/) zu Home Assistant
# (Long-Lived Access Token eines Admin-Benutzers, nur temporär für die Einrichtung)
HA_URL=https://homeassistant.example
HA_TOKEN=<long-lived-access-token>
